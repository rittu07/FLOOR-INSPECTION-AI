# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python & backend
.venv/
backend/.venv/
__pycache__/
*/__pycache__/
*/*/__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd

# weights and output directories
*.pt
captures/
backend/captures/
outputs/
backend/outputs/
debug/
backend/debug/
runs/
*.cache



# Crack datasets (rebuild with backend/ml/crack_detection/scripts/build_floor_dataset.py)
backend/ml/crack_detection/datasets/crack-seg/
backend/ml/crack_detection/datasets/floor_aug/
backend/ml/crack_detection/train_*.log

# Deployed crack model (stripped, ~23 MB) is versioned so clones and cloud builds get it
!backend/ml/crack_detection/models/best.pt
